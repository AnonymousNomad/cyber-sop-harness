{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cyber-sop-harness.local/schemas/engagement-manifest.schema.json",
  "title": "Engagement Manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "manifest_version",
    "engagement_id",
    "engagement_mode",
    "authorization",
    "third_party_refs",
    "scope",
    "time_window",
    "methods",
    "asset_criticality",
    "data_handling",
    "escalation_contacts",
    "credential_policy",
    "rate_limits",
    "cleanup",
    "stop_conditions"
  ],
  "properties": {
    "manifest_version": { "type": "string", "const": "1.0" },
    "engagement_id": { "type": "string", "minLength": 1, "maxLength": 128 },
    "engagement_mode": { "type": "string", "enum": ["fixture", "authorized"] },
    "third_party_refs": { "type": "array", "items": { "type": "string", "minLength": 1 } },
    "authorization": {
      "type": "object",
      "additionalProperties": false,
      "required": ["owner", "operator", "artifact_ref", "signature_ref"],
      "properties": {
        "owner": { "type": "string", "minLength": 1 },
        "operator": { "type": "string", "minLength": 1 },
        "artifact_ref": { "type": "string", "minLength": 1 },
        "signature_ref": { "type": "string", "minLength": 1 },
        "third_party_refs": { "type": "array", "items": { "type": "string" } }
      }
    },
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "required": ["allow", "deny", "redirect_policy", "third_party_policy"],
      "properties": {
        "allow": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
        "deny": { "type": "array", "items": { "type": "string", "minLength": 1 } },
        "redirect_policy": { "type": "string", "enum": ["same-origin", "allowlisted", "block"] },
        "third_party_policy": { "type": "string", "enum": ["explicit-permission", "block"] }
      }
    },
    "time_window": {
      "type": "object",
      "additionalProperties": false,
      "required": ["starts_at", "expires_at", "timezone"],
      "properties": {
        "starts_at": { "type": "string", "format": "date-time" },
        "expires_at": { "type": "string", "format": "date-time" },
        "timezone": { "type": "string", "minLength": 1 },
        "excluded_windows": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["starts_at", "expires_at", "reason"],
            "properties": {
              "starts_at": { "type": "string", "format": "date-time" },
              "expires_at": { "type": "string", "format": "date-time" },
              "reason": { "type": "string", "minLength": 1 }
            }
          }
        }
      }
    },
    "methods": {
      "type": "object",
      "additionalProperties": false,
      "required": ["allowed", "prohibited"],
      "properties": {
        "allowed": { "type": "array", "items": { "type": "string" } },
        "prohibited": { "type": "array", "items": { "type": "string" } }
      }
    },
    "asset_criticality": {
      "type": "object",
      "additionalProperties": false,
      "required": ["default", "targets"],
      "properties": {
        "default": { "type": "string", "enum": ["critical", "production", "non-production", "unknown"] },
        "targets": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["target_ref", "classification"],
            "properties": {
              "target_ref": { "type": "string", "minLength": 1 },
              "classification": { "type": "string", "enum": ["critical", "production", "non-production", "unknown"] }
            }
          }
        }
      }
    },
    "data_handling": {
      "type": "object",
      "additionalProperties": false,
      "required": ["classification", "redaction", "retention"],
      "properties": {
        "classification": { "type": "string", "enum": ["synthetic-only", "confidential", "restricted"] },
        "redaction": { "type": "string", "enum": ["required", "not-required"] },
        "retention": { "type": "string", "minLength": 1 }
      }
    },
    "escalation_contacts": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "channel", "address"],
        "properties": {
          "name": { "type": "string", "minLength": 1 },
          "channel": { "type": "string", "enum": ["email", "phone", "ticket", "secure-messaging"] },
          "address": { "type": "string", "minLength": 1 }
        }
      }
    },
    "credential_policy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["allowed_refs", "automatic_use", "expiry_policy"],
      "properties": {
        "allowed_refs": { "type": "array", "items": { "type": "string" } },
        "automatic_use": { "type": "boolean", "const": false },
        "expiry_policy": { "type": "string", "minLength": 1 }
      }
    },
    "rate_limits": {
      "type": "object",
      "additionalProperties": false,
      "required": ["requests_per_second", "concurrency", "payload_bytes"],
      "properties": {
        "requests_per_second": { "type": "number", "minimum": 0 },
        "concurrency": { "type": "integer", "minimum": 0 },
        "payload_bytes": { "type": "integer", "minimum": 0 }
      }
    },
    "cleanup": {
      "type": "object",
      "additionalProperties": false,
      "required": ["required", "owner", "procedure_ref"],
      "properties": {
        "required": { "type": "boolean", "const": true },
        "owner": { "type": "string", "minLength": 1 },
        "procedure_ref": { "type": "string", "minLength": 1 }
      }
    },
    "stop_conditions": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 }
    }
  }
}
